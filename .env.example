# Copy this file to .env and fill in your values from Supabase → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Openpay (primary payment processor for memberships)
VITE_OPENPAY_MERCHANT_ID=your-openpay-merchant-id
VITE_OPENPAY_PUBLIC_KEY=your-openpay-public-key
VITE_OPENPAY_SANDBOX_MODE=true

# Stripe (payment processor for memberships — embedded card form)
VITE_STRIPE_PUBLIC_KEY=your-stripe-publishable-key
# Price IDs from the Stripe dashboard (Products → recurring monthly prices)
VITE_STRIPE_PRICE_INDIVIDUAL=your-individual-price-id
VITE_STRIPE_PRICE_FAMILIAR=your-familiar-price-id
# STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET must be configured in Supabase
# Edge Function secrets, NOT in this frontend env file.

# PayPal Subscriptions — LEGACY: only for existing members still billed via
# PayPal. New memberships use Stripe; do not configure for new deployments.
VITE_PAYPAL_ENV=sandbox
VITE_PAYPAL_CLIENT_ID=your-paypal-client-id
VITE_PAYPAL_PLAN_INDIVIDUAL=your-individual-plan-id
VITE_PAYPAL_PLAN_FAMILIAR=your-familiar-plan-id
# PAYPAL_CLIENT_SECRET must be configured in Supabase Edge Function secrets,
# NOT in this frontend env file. See supabase/functions/paypal-subscription/index.ts

# Public org ID for self-service membership signup (no auth required)
VITE_PUBLIC_ORG_ID=
