# Copy this file to .env and fill in your values from Supabase → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Openpay (primary payment processor for memberships)
VITE_OPENPAY_MERCHANT_ID=your-openpay-merchant-id
VITE_OPENPAY_PUBLIC_KEY=your-openpay-public-key
VITE_OPENPAY_SANDBOX_MODE=true

# Stripe (secondary/fallback payment processor)
VITE_STRIPE_PUBLIC_KEY=your-stripe-publishable-key
